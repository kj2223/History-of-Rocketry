{
  "name": "Ad Astra",
  "productName": "Ad Astra",
  "version": "0.5.5",
  "description": "A management game about the American space programme",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.kj2223.projectvanguard",
    "files": [
      "desktop/**",
      "index.html",
      "style.css",
      "js/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "ProjectVanguard-Setup.${ext}"
    },
    "portable": {
      "artifactName": "ProjectVanguard-Portable.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
