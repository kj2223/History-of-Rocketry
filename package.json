{
  "name": "ad-astra",
  "productName": "Ad Astra",
  "version": "0.7.0",
  "description": "A side-scrolling game about the American space programme, from White Sands to Artemis",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predist": "node desktop/stamp-build.mjs",
    "dist": "electron-builder --win --publish never",
    "playtest-report": "node tools/playtest-report.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "prettier": "3.9.10"
  },
  "build": {
    "appId": "com.kj2223.projectvanguard",
    "files": [
      "desktop/**",
      "index.html",
      "style.css",
      "js/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "ProjectVanguard-Setup.${ext}"
    },
    "portable": {
      "artifactName": "ProjectVanguard-Portable.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
