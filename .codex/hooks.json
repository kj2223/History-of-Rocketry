{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\Projects\\History of Rocketry\\.codex\\hooks\\guard-main.mjs'"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\Projects\\History of Rocketry\\.codex\\hooks\\backup-design-docs.mjs'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\Projects\\History of Rocketry\\.codex\\hooks\\format-on-save.mjs'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\Projects\\History of Rocketry\\.codex\\hooks\\tests-before-stop.mjs'",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
